# Set the values in the process environment or use an env-file loader. Spring Boot
# and Android Gradle do not automatically read this file or a copy named .env.

# Spring Boot: required. Replace these placeholders with local or deployment values.
BOOKMARK_DB_USERNAME=replace-with-mysql-user
BOOKMARK_DB_PASSWORD=replace-with-mysql-password
# Base64 encoding of at least 32 random bytes. Keep the same key across restarts.
BOOKMARK_JWT_SECRET=replace-with-base64-encoded-random-key
# Gmail SMTP credentials for email verification and password reset.
MAIL_USERNAME=replace-with-gmail-address
MAIL_PASSWORD=replace-with-smtp-app-password

# Spring Boot: optional. This JDBC URL is the local default. For a remote MySQL
# instance, set its URL and TLS options explicitly.
# DB_URL=jdbc:mysql://localhost:3306/bookmark_db?useSSL=false&serverTimezone=UTC
# Leave empty to disable Google sign-in on the backend. When enabled, use the same
# OAuth Web Client ID for Android (Gradle property or environment variable).
GOOGLE_WEB_CLIENT_ID=
# Defaults to uploads/avatars relative to the backend working directory. Use a
# persistent directory for deployments that need to keep uploaded avatars.
# AVATAR_UPLOAD_DIR=uploads/avatars
# Public backend root used in avatar URLs. Defaults to http://localhost:8080.
# For the Android emulator, use http://10.0.2.2:8080 when testing a local backend.
# BOOKMARK_PUBLIC_BASE_URL=https://api.example.com

# Android Gradle: required only for Release. Supply a stable HTTPS URL ending in
# a slash. A Gradle property with the same name takes priority.
# BOOKMARK_RELEASE_API_BASE_URL=https://api.example.com/
# Debug uses the BOOKMARK_API_BASE_URL Gradle property. For a local emulator, pass
# -PBOOKMARK_API_BASE_URL=http://10.0.2.2:8080/ to Gradle.
